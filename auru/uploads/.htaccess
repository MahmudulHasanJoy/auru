# AURU Upload Directory — Deny ALL direct web access
# Files here must ONLY be served through download.php with session validation

Order deny,allow
Deny from all

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none';"
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
